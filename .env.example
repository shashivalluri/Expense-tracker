# MongoDB Atlas connection string.
# For local dev, use: mongodb://127.0.0.1:27017/expense-tracker
# For production (Vercel), use the Atlas connection string:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expense-tracker?retryWrites=true&w=majority"

# JWT secrets — must be long, random, and different from each other in production.
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-token-secret"
JWT_ACCESS_EXPIRE="15m"
JWT_REFRESH_EXPIRE="7d"

# Frontend URL used in verification and password reset email links.
APP_URL="https://your-vercel-app.vercel.app"
CLIENT_URL="https://your-vercel-app.vercel.app"

# Optional: Email provider for verification and password reset emails (via Resend).
RESEND_API_KEY=""
EMAIL_FROM="Budget Tracker Pro <no-reply@your-domain.com>"

# Runtime
NODE_ENV="production"
